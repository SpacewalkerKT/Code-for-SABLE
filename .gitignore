# ============================================================
# SABLE Project .gitignore
# For IEEE OJ-ITS Paper Reproducibility
# ============================================================

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------
# Virtual Environments
# ------------------------------------------------------------
venv/
.venv/
ENV/
env/
.env/

# ------------------------------------------------------------
# IDE and Editors
# ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-*
.spyderproject
.spyproject

# ------------------------------------------------------------
# Jupyter Notebook
# ------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ------------------------------------------------------------
# Output Directories
# ------------------------------------------------------------
outputs/
runs/
results/
cache/
metrics/
figures/
logs/
logs_remote/
outputs_remote/
cloud_server_artifacts/
results_20260210_170129/
checkpoints/
src/checkpoints/
src/artifacts/

# ------------------------------------------------------------
# Data Directories (Complete Exclusion)
# ------------------------------------------------------------
# Ignore entire data/ directory to prevent accidental commits
# data/ contains large CSV files (410 MB+) that should not be in Git
data/

# If you need to keep directory structure, uncomment below:
# !data/.gitkeep
# !data/raw/.gitkeep
# !data/processed/.gitkeep
# !data/cache/.gitkeep

# ------------------------------------------------------------
# Temporary & Generated Files
# ------------------------------------------------------------
*.log
*.tmp
*.bak
*.bak_*

# Result files
*.csv
!requirements.txt
!data/processed/task_sampling_summary.csv

# Documentation files (not for code)
*.docx
*.doc
*.pdf
!docs/paper/*.pdf

# Archives

# ------------------------------------------------------------
# OS Generated Files
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Cloud Deployment (Not for GitHub)
# ------------------------------------------------------------
.cloudignore
server_info.sh
rollback_docs_reorg.sh

# ------------------------------------------------------------
# Documentation Archives
# ------------------------------------------------------------
docs/_backup/
docs/archive/
docs/legacy/

# ------------------------------------------------------------
# Testing & Coverage
# ------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------
# Experimental Files (Keep Structure)
# ------------------------------------------------------------
# Keep experiment configs but not outputs
experiments/outputs/
experiments/results/
experiments/logs/

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
*.pkl
*.pt
*.pth
*.ckpt
!outputs/.gitkeep
!runs/.gitkeep
!outputs/checkpoints/.gitkeep

# Task sampling logs
task_sampling_log.csv
task_sampling_summary.csv
efficiency_summary.csv
docs_file_list.txt

# Microsoft Office temp files
~$*.docx
~$*.xlsx
~$*.pptx
